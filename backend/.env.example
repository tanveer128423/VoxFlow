
APP_ENV=development
FRONTEND_ORIGIN=http://localhost:5173

OPENAI_API_KEY=
# Fallback pipeline models (used only when the matching provider is selected).
LLM_MODEL=gpt-4o-mini
STT_MODEL=whisper-1
# Deepgram STT (optional; requires live verification). Obtain a key at
# https://console.deepgram.com/ . Model identifiers: https://developers.deepgram.com/
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2
REALTIME_MODEL=gpt-realtime-2.1-mini
REALTIME_VOICE=marin
REALTIME_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
REALTIME_SESSION_RATE_LIMIT_PER_MINUTE=10
GOOGLE_APPLICATION_CREDENTIALS=

ELEVENLABS_API_KEY=PASTE_THE_PROVIDED_KEY_HERE
# Fallback ElevenLabs voice (fallback TTS only; the in-app dropdown is for live
# Realtime voices). Voice IDs come from your ElevenLabs account Voice Library.
ELEVENLABS_VOICE_ID=PASTE_THE_VOICE_ID_HERE
# Default fallback TTS model. Newer/lower-cost alternatives were requested for
# investigation; verify pricing, availability, and quality before changing.
# See https://elevenlabs.io/docs/capabilities/text-to-speech and /pricing.
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# Optional ElevenLabs voice settings (all optional; leave blank to send no
# voice_settings object and keep the default payload). Ranges 0.0-1.0.
# Support depends on the selected model/account; verify before relying on them.
ELEVENLABS_STABILITY=
ELEVENLABS_SIMILARITY_BOOST=
ELEVENLABS_STYLE=
ELEVENLABS_USE_SPEAKER_BOOST=
# ElevenLabs speaking speed. Documented range 0.7-1.2 (default 1.0). Support is
# model-specific; verify with live credentials. Leave blank to send no speed.
# This is the global default; a per-agent speed override (see README) takes
# precedence for a single turn via the /api/voice-turn `speed` field.
ELEVENLABS_SPEED=
# Google TTS speaking rate. Documented range 0.25-4.0 (default 1.0). Leave blank
# to use the provider default (no override sent). A per-agent speed override
# takes precedence for a single turn.
GOOGLE_SPEAKING_RATE=

# Fallback providers. STT: mock | openai | deepgram. LLM: mock | openai.
# TTS: mock | elevenlabs | google. Default is mock for all.
STT_PROVIDER=openai
LLM_PROVIDER=openai
TTS_PROVIDER=elevenlabs
SIMULATE_TTS_FAILURE=false
SIMULATE_TTS_RETRY_WITH_MOCK=false

MAX_AUDIO_BYTES=10485760
MAX_AUDIO_SECONDS=120
PROVIDER_TIMEOUT_SECONDS=30
